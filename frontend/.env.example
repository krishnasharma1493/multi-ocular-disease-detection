# ── API ───────────────────────────────────────────────────────────────────
# Empty = same origin (the backend serves the built app on http://127.0.0.1:7860).
VITE_API_BASE_URL=

# ── Feature flags ────────────────────────────────────────────────────────
VITE_AUTH_DISABLED=false         # must match backend AUTH_DISABLED

# ── Uploads (client-side pre-check only; the backend enforces the real limit) ──
VITE_MAX_UPLOAD_MB=10            # keep equal to backend MAX_UPLOAD_MB

# ── Demo mode: pre-fills the login form ──────────────────────────────────
# Everything prefixed VITE_ ships to the browser. Acceptable ONLY because this is a shared
# demo password protecting synthetic data. Never put a real secret here.
VITE_DEMO_MODE=true
VITE_DEMO_EMAIL=demo@example.com
VITE_DEMO_PASSWORD=camp-S3HqmECzyZSY
