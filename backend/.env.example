# ── Server ──────────────────────────────────────────────────────────────
APP_ENV=development              # development | demo | test
PORT=7860

# ── Database (relative paths resolve against backend/) ───────────────────
DATABASE_URL=sqlite:///./app.db

# ── Auth (demo-grade) ────────────────────────────────────────────────────
# This whole file is optional: with no backend/.env the app starts with the values below.
# Empty JWT_SECRET = a random key generated on first start, kept in backend/.jwt_secret (git-ignored).
# Set your own for any shared deployment: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRES_MINUTES=720
# Shared password for the seeded demo accounts (demo@example.com, judge@example.com). It is public
# (built into the code) because the accounts and data are fictional. Change it for anything beyond a local demo.
DEMO_PASSWORD=camp-S3HqmECzyZSY
# Emergency switch: every request acts as the first seeded user. Synthetic data only.
AUTH_DISABLED=false

# ── CORS (only needed for the Vite dev server; comma-separated, no trailing slash) ──
CORS_ORIGINS=http://localhost:5173

# ── Demo data ────────────────────────────────────────────────────────────
SEED_ON_STARTUP=true             # seeds an empty DB on boot

# ── Model (paths relative to backend/ or absolute) ───────────────────────
MODEL_CHECKPOINT=../outputs/best_efficientnet_b0.pth
MODEL_METRICS=../outputs/metrics.json
MODEL_DEVICE=auto                # auto | cpu | cuda | mps
USE_MOCKS=false                  # true = never load the model
DEMO_FIXTURES=false              # true = demo only: seeded sample screenings may show precomputed results (labelled DEMO)
INFERENCE_TIMEOUT_S=30           # one screening (model + Grad-CAM) fails with 504 after this many seconds

# ── Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ── Built frontend served on the same port ───────────────────────────────
FRONTEND_DIST=../frontend/dist
